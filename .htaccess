Options -MultiViews -Indexes
DirectoryIndex index.html
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonicalize legacy public URLs before the route fallback.
  RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+forum-category\.html(?:[?\s]) [NC]
  RewriteCond %{QUERY_STRING} ^(?:.*&)?slug=([^&]+)(?:&.*)?$ [NC]
  RewriteRule ^forum-category\.html$ /forum/%1? [R=301,L,NE]

  RewriteCond %{THE_REQUEST} \s/+topic\.html(?:[?\s]) [NC]
  RewriteCond %{QUERY_STRING} ^(?:.*&)?id=([^&]+)(?:&.*)?$ [NC]
  RewriteRule ^topic\.html$ /forum/topic/%1? [R=301,L,NE]

  RewriteCond %{THE_REQUEST} \s/+forum-user\.html(?:[?\s]) [NC]
  RewriteCond %{QUERY_STRING} ^(?:.*&)?id=([^&]+)(?:&.*)?$ [NC]
  RewriteRule ^forum-user\.html$ /user/%1? [R=301,L,NE]

  RewriteCond %{THE_REQUEST} \s/+forum\.html(?:[?\s]) [NC]
  RewriteRule ^forum\.html$ /forum [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+forum-members\.html(?:[?\s]) [NC]
  RewriteRule ^forum-members\.html$ /members [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+forum-search\.html(?:[?\s]) [NC]
  RewriteRule ^forum-search\.html$ /search [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+cabinet\.html(?:[?\s]) [NC]
  RewriteRule ^cabinet\.html$ /cabinet [R=301,L]

  # Existing assets are served directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Static single-page routes.
  RewriteRule ^(forum|members|search|cabinet|privacy|forum/reports)/?$ index.html [L,QSA]
  RewriteRule ^forum/topic/[^/]+/?$ index.html [L,QSA]
  RewriteRule ^forum/[^/]+/?$ index.html [L,QSA]
  RewriteRule ^user/[^/]+/?$ index.html [L,QSA]
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
<FilesMatch "^\.(?!well-known)">
  Require all denied
</FilesMatch>