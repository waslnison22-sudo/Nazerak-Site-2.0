Options -MultiViews -Indexes
DirectoryIndex index.html
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # Retire removed application routes; do not serve the landing app as fake forum pages.
  RewriteRule ^(forum|members|search|cabinet|privacy|user)(/.*)?/?$ / [R=301,L,NC]
  RewriteRule ^(forum\.html|forum-members\.html|forum-search\.html|forum-user\.html|forum-category\.html|topic\.html|cabinet\.html)$ / [R=301,L,NC]

  # Existing files are served directly; unknown paths stay 404.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
<FilesMatch "^\.(?!well-known)">
  Require all denied
</FilesMatch>
